# Server Configuration
PORT=8080

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/content_generator
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/content_generator?retryWrites=true&w=majority

# JWT Secret (change this in production!)
JWT_SECRET=your-secret-key-change-in-production-make-it-long-and-random

# AI Configuration - Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
USE_GEMINI=true

# AI Configuration - Ollama (Local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# Other popular models: mistral, codellama, neural-chat, starling-lm
USE_OLLAMA=false

# Note: Set USE_GEMINI=true to use Gemini API, or USE_OLLAMA=true for local Ollama
# If both are false, a placeholder response will be used
